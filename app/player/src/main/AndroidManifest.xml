<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application>
        <activity
            android:name="com.phlox.tvwebbrowser.player.NativeVideoActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            tools:ignore="DiscouragedApi" />

        <activity
            android:name="com.phlox.tvwebbrowser.player.SystemPlayerActivity"
            android:configChanges="keyboard|keyboardHidden|screenLayout|screenSize|orientation|smallestScreenSize|uiMode"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:exported="false"
            android:theme="@android:style/Theme.Black.NoTitleBar.Fullscreen"
            tools:ignore="DiscouragedApi" />
    </application>
</manifest>
