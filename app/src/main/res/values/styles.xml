<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="@style/Theme.TVBro" />

    <!--
    Widget styles. Layouts set them with style="..." on each view; the theme does not set them as
    defaults (buttonStyle and others), so views without a style keep the platform look.
    -->

    <!-- A text button with the app's button background (its padding comes from the background) -->
    <style name="Widget.TVBro.Button" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/button_bg_selector</item>
    </style>

    <!-- An icon button with the app's button background -->
    <style name="Widget.TVBro.ImageButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@drawable/button_bg_selector</item>
    </style>

    <!-- Buttons around the cursor in the cursor menu -->
    <style name="Widget.TVBro.ImageButton.CursorMenu">
        <item name="android:scaleType">fitCenter</item>
        <item name="tint">?attr/tbColorIconCursorMenu</item>
    </style>

    <!--
    The browser bar of the redesign. Its buttons have fixed sizes; the paddings fit icons of any
    intrinsic size to the board size, and the icons get the design system icon color.
    -->
    <style name="Widget.TVBro.ImageButton.Ds" parent="Widget.AppCompat.ImageButton">
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:scaleType">fitCenter</item>
        <item name="android:focusable">true</item>
        <item name="tint">?attr/tbColorDsIcon</item>
    </style>

    <!-- A segment of a toolbar group -->
    <style name="Widget.TVBro.ImageButton.Ds.Segment">
        <item name="android:layout_width">@dimen/ds_size_toolbar_segment</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/ds_control_bg</item>
        <item name="android:paddingStart">@dimen/ds_toolbar_icon_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/ds_toolbar_icon_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/ds_toolbar_icon_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/ds_toolbar_icon_padding_vertical</item>
    </style>

    <!-- A button on its own in the bar (the close-app button) -->
    <style name="Widget.TVBro.ImageButton.Ds.Standalone">
        <item name="android:layout_width">@dimen/ds_size_chrome_control</item>
        <item name="android:layout_height">@dimen/ds_size_chrome_control</item>
        <item name="android:background">@drawable/ds_icon_button_bg</item>
        <item name="android:padding">@dimen/ds_close_icon_padding</item>
    </style>

    <!-- A button inside the address field -->
    <style name="Widget.TVBro.ImageButton.Ds.Field">
        <item name="android:layout_width">@dimen/ds_size_toolbar_segment</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">@drawable/ds_field_button_bg</item>
        <item name="android:paddingStart">@dimen/ds_field_icon_padding_horizontal</item>
        <item name="android:paddingEnd">@dimen/ds_field_icon_padding_horizontal</item>
        <item name="android:paddingTop">@dimen/ds_field_icon_padding_vertical</item>
        <item name="android:paddingBottom">@dimen/ds_field_icon_padding_vertical</item>
    </style>

    <!-- A group of toolbar segments; the group clips them to its rounded border (ActionBar sets clipToOutline) -->
    <style name="Widget.TVBro.ToolbarGroup" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:layout_marginStart">@dimen/ds_space_gutter</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:background">@drawable/ds_control_group_bg</item>
        <item name="android:padding">@dimen/ds_border_hairline</item>
    </style>

    <!-- The separator between toolbar segments -->
    <style name="Widget.TVBro.ToolbarSeparator" parent="">
        <item name="android:layout_width">@dimen/ds_border_hairline</item>
        <item name="android:layout_height">match_parent</item>
        <item name="android:background">?attr/tbColorDsLineStrong</item>
    </style>

    <!-- A row of a panel: an icon, a title with a second line, a value -->
    <style name="Widget.TVBro.PanelRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/ds_panel_row_height</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/ds_space_menu_inset</item>
        <item name="android:paddingEnd">@dimen/ds_space_menu_inset</item>
        <item name="android:background">@drawable/ds_menu_row_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- A row of a menu: an icon and a label -->
    <style name="Widget.TVBro.MenuRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/ds_size_menu_row</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">@dimen/ds_space_menu_inset</item>
        <item name="android:paddingEnd">@dimen/ds_space_menu_inset</item>
        <item name="android:background">@drawable/ds_menu_row_bg</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>

    <!-- The icon of a menu or panel row -->
    <style name="Widget.TVBro.MenuIcon" parent="">
        <item name="android:layout_width">@dimen/ds_size_icon_menu</item>
        <item name="android:layout_height">@dimen/ds_size_icon_menu</item>
        <item name="tint">?attr/tbColorDsIcon</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- A hairline between menu or panel rows -->
    <style name="Widget.TVBro.MenuSeparator" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/ds_border_hairline</item>
        <item name="android:background">?attr/tbColorDsLine</item>
    </style>

    <!-- A divider inside the address field -->
    <style name="Widget.TVBro.FieldDivider" parent="">
        <item name="android:layout_width">@dimen/ds_border_hairline</item>
        <item name="android:layout_height">@dimen/ds_field_divider_height</item>
        <item name="android:layout_gravity">center_vertical</item>
        <item name="android:background">?attr/tbColorDsDivider</item>
    </style>

    <!--
    Text sizes. These styles set only the size, so the text keeps the color of the view's default
    appearance (a textAppearance would replace it).
    -->
    <style name="Widget.TVBro.Text" parent="" />

    <!-- Titles of list items, list section headers, big placeholders -->
    <style name="Widget.TVBro.Text.Headline">
        <item name="android:textSize">@dimen/text_size_headline</item>
    </style>

    <!-- Dialog titles, tab titles, secondary lines of list items, notifications -->
    <style name="Widget.TVBro.Text.Title">
        <item name="android:textSize">@dimen/text_size_title</item>
    </style>

    <!-- URLs under titles, rows of the shortcuts list -->
    <style name="Widget.TVBro.Text.Subtitle">
        <item name="android:textSize">@dimen/text_size_subtitle</item>
    </style>

    <!-- Labels of settings, bookmark titles -->
    <style name="Widget.TVBro.Text.Body">
        <item name="android:textSize">@dimen/text_size_body</item>
    </style>

    <!-- Bookmark URLs, values next to settings -->
    <style name="Widget.TVBro.Text.Caption">
        <item name="android:textSize">@dimen/text_size_caption</item>
    </style>

    <!-- Counters on buttons -->
    <style name="Widget.TVBro.Text.Badge">
        <item name="android:textSize">@dimen/text_size_badge</item>
    </style>

    <!-- Text styles of the redesigned screens (design system type styles) -->

    <!-- The url in the address field -->
    <style name="Widget.TVBro.Text.Address">
        <item name="android:textSize">@dimen/ds_text_address</item>
    </style>

    <!-- Toast messages -->
    <style name="Widget.TVBro.Text.Toast">
        <item name="android:textSize">@dimen/ds_text_toast</item>
    </style>

    <!-- Rows of menus and panels -->
    <style name="Widget.TVBro.Text.MenuItem">
        <item name="android:textSize">@dimen/ds_text_menu_item</item>
    </style>

    <!-- Page titles on tabs -->
    <style name="Widget.TVBro.Text.TabTitle">
        <item name="android:textSize">@dimen/ds_text_tab_title</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>

    <!-- The label of a menu row -->
    <style name="Widget.TVBro.Text.MenuItem.Row">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/ds_space_menu_inset</item>
        <item name="android:textColor">?attr/tbColorDsInk</item>
        <item name="android:singleLine">true</item>
        <item name="android:ellipsize">end</item>
    </style>

    <!-- The second line of a menu or panel row -->
    <style name="Widget.TVBro.Text.MenuCaption">
        <item name="android:textSize">@dimen/ds_text_menu_caption</item>
    </style>

    <!-- The count of blocked ads and pop-ups on the site button -->
    <style name="Widget.TVBro.Text.CountBadge">
        <item name="android:textSize">@dimen/ds_text_badge</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- A row of a list (RecyclerView): focusable, highlighted when focused -->
    <style name="Widget.TVBro.ListItem" parent="">
        <item name="android:focusable">true</item>
        <item name="android:background">@drawable/list_item_bg_selector</item>
    </style>

    <!-- A settings row: a label and a switch -->
    <style name="Widget.TVBro.SettingsRow" parent="">
        <item name="android:layout_marginTop">@dimen/settings_section_spacing</item>
        <item name="android:paddingTop">5dp</item>
        <item name="android:orientation">horizontal</item>
    </style>
</resources>
