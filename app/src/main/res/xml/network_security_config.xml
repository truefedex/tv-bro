<?xml version="1.0" encoding="utf-8"?>
<!--Android 7.0 has no roots of Let's Encrypt, which many sites use: they are added to the system ones.
    With this config the manifest's usesCleartextTraffic is ignored, so cleartext is allowed here.-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="@raw/isrg_root_x1" />
            <certificates src="@raw/isrg_root_x2" />
        </trust-anchors>
    </base-config>
</network-security-config>
