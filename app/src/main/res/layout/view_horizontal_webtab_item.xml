<?xml version="1.0" encoding="utf-8"?>
<!-- A tab: one focus stop; selected (activated) when it is the current tab -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="@dimen/ds_size_tab_width"
    android:layout_height="@dimen/ds_size_tab_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:nextFocusDown="@+id/ibCloseTab"
    android:paddingStart="@dimen/ds_space_tab_inset"
    android:paddingEnd="@dimen/ds_space_tab_inset"
    android:background="@drawable/ds_tab_bg">

    <!-- round (the adapter clips it to an oval) -->
    <ImageView
        android:id="@+id/ivFavicon"
        android:layout_width="@dimen/ds_size_favicon_tab"
        android:layout_height="@dimen/ds_size_favicon_tab"
        android:scaleType="centerCrop"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_launcher" />

    <TextView
        style="@style/Widget.TVBro.Text.TabTitle"
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="@dimen/ds_space_icon_text"
        android:textColor="?attr/tbColorDsInk"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="@string/app_name" />
</LinearLayout>
