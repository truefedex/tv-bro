<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/settings_row_min_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="@dimen/settings_row_horizontal_padding"
    android:paddingRight="@dimen/settings_row_horizontal_padding"
    android:focusable="true"
    android:clickable="true"
    android:background="@drawable/settings_row_bg_selector">

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/settings_row_icon_size"
        android:layout_height="@dimen/settings_row_icon_size"
        android:layout_marginEnd="@dimen/settings_row_icon_margin_end"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_settings_search_24dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:paddingTop="10dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="16sp"
            android:textColor="@color/day_night_text_color_contrast"
            tools:text="Home page" />

        <TextView
            android:id="@+id/tvSummary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="12sp"
            android:textColor="@color/day_night_text_color"
            android:visibility="gone"
            tools:text="Summary" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:maxWidth="280dp"
        android:maxLines="1"
        android:ellipsize="end"
        android:textSize="14sp"
        android:textColor="@color/day_night_text_color"
        tools:text="DuckDuckGo" />

    <ImageView
        android:id="@+id/ivChevron"
        android:layout_width="18dp"
        android:layout_height="18dp"
        android:layout_marginStart="8dp"
        android:importantForAccessibility="no"
        android:src="@drawable/ic_settings_chevron_18dp" />
</LinearLayout>
