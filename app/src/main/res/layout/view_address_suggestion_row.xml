<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the address suggestions of the TV bar: the favicon, the title and the address. Not focusable:
     the focus stays in the address field, the row chosen with the D-pad is selected. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/ds_download_row_height"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingStart="@dimen/ds_space_menu_inset"
    android:paddingEnd="@dimen/ds_space_menu_inset"
    android:background="@drawable/ds_suggestion_row_bg"
    android:clickable="true"
    android:focusable="false">

  <ImageView
      android:id="@+id/ivIcon"
      android:layout_width="@dimen/ds_bookmark_icon"
      android:layout_height="@dimen/ds_bookmark_icon"
      android:scaleType="fitCenter"
      android:importantForAccessibility="no"
      tools:src="@drawable/ic_not_available" />

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:paddingTop="@dimen/ds_bookmark_row_text_padding"
      android:paddingBottom="@dimen/ds_bookmark_row_text_padding"
      android:layout_marginStart="@dimen/ds_space_icon_text"
      android:orientation="vertical">

    <TextView
        style="@style/Widget.TVBro.Text.MenuItem"
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/tbColorDsInk"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="YouTube" />

    <TextView
        style="@style/Widget.TVBro.Text.MenuCaption"
        android:id="@+id/tvCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="?attr/tbColorDsInk"
        android:singleLine="true"
        android:ellipsize="end"
        tools:text="www.youtube.com" />
  </LinearLayout>
</LinearLayout>
