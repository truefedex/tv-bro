<?xml version="1.0" encoding="utf-8"?>
<!--
The phone screen: the page and the bar under it, between the system bars and the keyboard (the shell
applies their insets as the padding of the content), and the menu sheet, the tab switcher, the
bookmarks and the downloads over the whole window.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/tbColorDsBgChrome">

    <RelativeLayout
        android:id="@+id/rlRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- it tells the bar whether the page scrolls by the user's touch -->
        <com.phlox.tvwebbrowser.activity.main.view.TouchTrackingFrameLayout
            android:id="@+id/flWebViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/vPhoneBar" />

        <com.phlox.tvwebbrowser.activity.main.view.PhoneBar
            android:id="@+id/vPhoneBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:elevation="4dp" />

        <!-- along the top edge of the page -->
        <ProgressBar
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:progressTint="?attr/tbColorProgress"
            android:progressBackgroundTint="@android:color/transparent"
            android:visibility="gone" />

        <!-- tells about downloads, above the bar -->
        <com.phlox.tvwebbrowser.activity.main.view.PhoneSnackbar
            android:id="@+id/vSnackbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_above="@+id/vPhoneBar"
            android:layout_margin="@dimen/ds_phone_snackbar_margin"
            android:elevation="@dimen/ds_phone_snackbar_elevation" />

        <ProgressBar
            android:id="@+id/progressBarGeneric"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:visibility="gone" />
    </RelativeLayout>

    <com.phlox.tvwebbrowser.activity.main.view.PhoneMenuSheet
        android:id="@+id/vMenuSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="8dp" />

    <!-- the settings of the current site, from the site button of the bar or the menu sheet -->
    <com.phlox.tvwebbrowser.activity.main.view.PhoneSiteSheet
        android:id="@+id/vSiteSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="8dp" />

    <com.phlox.tvwebbrowser.activity.main.view.PhoneTabSwitcher
        android:id="@+id/vTabSwitcher"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="8dp" />

    <com.phlox.tvwebbrowser.activity.main.view.PhoneBookmarksView
        android:id="@+id/vBookmarks"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="8dp" />

    <com.phlox.tvwebbrowser.activity.main.view.PhoneDownloadsView
        android:id="@+id/vDownloads"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="8dp" />

    <com.phlox.tvwebbrowser.activity.main.view.PhoneHistoryView
        android:id="@+id/vHistory"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="8dp" />

    <!-- sending tabs and bookmarks to TVs -->
    <com.phlox.tvwebbrowser.activity.main.view.PhoneSyncView
        android:id="@+id/vSync"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="8dp" />

    <!-- the actions of a bookmark, a download or a history item, above them -->
    <com.phlox.tvwebbrowser.activity.main.view.PhoneActionsSheet
        android:id="@+id/vActionsSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="9dp" />
</FrameLayout>
