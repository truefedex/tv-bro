<?xml version="1.0" encoding="utf-8"?>
<!--
The phone screen: the page and the bar under it, between the system bars and the keyboard (the shell
applies their insets as the padding of the content), and the menu sheet over the whole window.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/flRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/tbColorDsBgChrome">

    <RelativeLayout
        android:id="@+id/rlRoot"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <FrameLayout
            android:id="@+id/flWebViewContainer"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/vPhoneBar" />

        <com.phlox.tvwebbrowser.activity.main.view.PhoneBar
            android:id="@+id/vPhoneBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:elevation="4dp" />

        <!-- along the top edge of the page -->
        <ProgressBar
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:id="@+id/progressBar"
            android:layout_width="match_parent"
            android:layout_height="3dp"
            android:progressTint="?attr/tbColorProgress"
            android:progressBackgroundTint="@android:color/transparent"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/progressBarGeneric"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:visibility="gone" />
    </RelativeLayout>

    <com.phlox.tvwebbrowser.activity.main.view.PhoneMenuSheet
        android:id="@+id/vMenuSheet"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="8dp" />
</FrameLayout>
