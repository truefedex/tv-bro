<?xml version="1.0" encoding="utf-8"?>
<!-- The form of a bookmark of the home page: its name and address, as in the bookmarks panel -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="?attr/dialogPreferredPadding"
    android:paddingEnd="?attr/dialogPreferredPadding">

  <TextView
      style="@style/Widget.TVBro.Text.FieldLabel"
      android:labelFor="@+id/etTitle"
      android:text="@string/name" />

  <EditText
      style="@style/Widget.TVBro.Field.Ds"
      android:id="@+id/etTitle"
      android:inputType="text"
      android:imeOptions="actionNext"
      android:importantForAutofill="no" />

  <TextView
      style="@style/Widget.TVBro.Text.FieldLabel"
      android:labelFor="@+id/etUrl"
      android:text="@string/url" />

  <EditText
      style="@style/Widget.TVBro.Field.Ds"
      android:id="@+id/etUrl"
      android:inputType="textUri"
      android:imeOptions="actionDone"
      android:importantForAutofill="no" />
</LinearLayout>
