<?xml version="1.0" encoding="utf-8"?>
<!--
A panel at the end of the screen over a video (PlayerPanelView): a column of the full height with the title and the
caption of its page (a back arrow on a page under another), its rows and, at the bottom, what Back does
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout"
    tools:theme="@style/ThemeOverlay.TVBro.Video">

    <LinearLayout
        android:id="@+id/llPanel"
        android:layout_width="@dimen/player_panel_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:paddingTop="@dimen/player_panel_padding_top"
        android:paddingStart="@dimen/player_panel_padding_x"
        android:paddingEnd="@dimen/player_panel_padding_x"
        android:paddingBottom="@dimen/player_panel_padding_bottom"
        android:background="?attr/tbColorDsMenu"
        android:elevation="@dimen/player_panel_elevation"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/player_panel_header_padding"
            android:paddingEnd="@dimen/player_panel_header_padding"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="@dimen/player_panel_back_icon"
                android:layout_height="@dimen/player_panel_back_icon"
                android:layout_marginEnd="@dimen/player_panel_badge_gap"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_back"
                android:visibility="gone"
                app:tint="?attr/tbColorDsIcon"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="@dimen/player_panel_text_title"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="?attr/tbColorDsInk"
                    android:singleLine="true"
                    android:ellipsize="end"
                    tools:text="Video settings" />

                <TextView
                    android:id="@+id/tvCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/video_osd_caption_gap"
                    android:textSize="@dimen/player_panel_text_caption"
                    android:textColor="?attr/tbColorDsInkFaint"
                    android:maxLines="2"
                    android:ellipsize="end"
                    tools:text="TV Bro player · 1080p · HLS" />
            </LinearLayout>
        </LinearLayout>

        <ScrollView
            android:id="@+id/svRows"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="@dimen/player_panel_rows_margin_top"
            android:scrollbars="none"
            android:overScrollMode="never">

            <LinearLayout
                android:id="@+id/llRows"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </ScrollView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/player_panel_rows_margin_top"
            android:paddingStart="@dimen/player_panel_header_padding"
            android:paddingEnd="@dimen/player_panel_header_padding"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                style="@style/Widget.TVBro.KeyCap"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/ds_key_cap_height"
                android:importantForAccessibility="no"
                android:text="@string/key_back" />

            <TextView
                android:id="@+id/tvFooter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/video_osd_hint_key_gap"
                android:textSize="@dimen/player_panel_text_row"
                android:textColor="?attr/tbColorDsInk"
                android:singleLine="true"
                android:ellipsize="end"
                tools:text="Close" />
        </LinearLayout>
    </LinearLayout>
</merge>
