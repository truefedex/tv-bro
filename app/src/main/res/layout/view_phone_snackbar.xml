<?xml version="1.0" encoding="utf-8"?>
<!-- The snackbar of the phone over the page: an icon, a title and a caption, a text button -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout"
    tools:orientation="horizontal">

  <ImageView
      android:id="@+id/ivIcon"
      android:layout_width="@dimen/ds_phone_snackbar_icon"
      android:layout_height="@dimen/ds_phone_snackbar_icon"
      android:layout_marginStart="@dimen/ds_phone_snackbar_margin"
      android:importantForAccessibility="no"
      android:tint="?attr/tbColorDsOnToast"
      tools:src="@drawable/ic_downloads" />

  <LinearLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_marginStart="@dimen/ds_phone_snackbar_margin"
      android:layout_marginEnd="@dimen/ds_phone_snackbar_padding"
      android:orientation="vertical">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/ds_text_menu_item"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/tbColorDsOnToast"
        android:singleLine="true"
        tools:text="@string/download_complete" />

    <TextView
        android:id="@+id/tvCaption"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="@dimen/ds_text_phone_caption"
        android:textColor="?attr/tbColorDsOnToast"
        android:singleLine="true"
        android:ellipsize="middle"
        tools:text="tvbro-2.4.0-arm64-v8a.apk" />
  </LinearLayout>

  <TextView
      android:id="@+id/btnAction"
      android:layout_width="wrap_content"
      android:layout_height="@dimen/ds_phone_pill_height"
      android:gravity="center"
      android:paddingStart="@dimen/ds_phone_text_button_padding"
      android:paddingEnd="@dimen/ds_phone_text_button_padding"
      android:background="@drawable/ds_phone_button_bg"
      android:textSize="@dimen/ds_text_menu_item"
      android:fontFamily="sans-serif-medium"
      android:textColor="?attr/tbColorDsOnToast"
      android:clickable="true"
      tools:text="@string/install" />
</merge>
