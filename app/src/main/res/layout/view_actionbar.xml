<?xml version="1.0" encoding="utf-8"?>
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout"
    tools:orientation="horizontal">

  <ImageButton
      android:id="@+id/ibTabs"
      android:layout_width="@dimen/toolbar_button_size"
      android:layout_height="@dimen/toolbar_button_size"
      android:scaleType="fitCenter"
      android:padding="8dp"
      android:layout_marginStart="4dp"
      android:layout_marginTop="4dp"
      android:layout_marginEnd="2dp"
      android:src="@drawable/ic_menu_grey_900_36dp"
      android:nextFocusRight="@+id/ibBack"
      android:background="@drawable/icon_button_bg_selector"
      android:focusable="true"
      android:contentDescription="@string/tabs" />

  <ImageButton
      android:id="@+id/ibBack"
      android:layout_width="@dimen/toolbar_button_size"
      android:layout_height="@dimen/toolbar_button_size"
      android:scaleType="fitCenter"
      android:padding="8dp"
      android:layout_marginTop="4dp"
      android:src="@drawable/back_icon_selector"
      android:nextFocusRight="@+id/ibForward"
      android:background="@drawable/icon_button_bg_selector"
      android:contentDescription="@string/navigate_back" />

  <ImageButton
      android:id="@+id/ibForward"
      android:layout_width="@dimen/toolbar_button_size"
      android:layout_height="@dimen/toolbar_button_size"
      android:scaleType="fitCenter"
      android:padding="8dp"
      android:layout_marginTop="4dp"
      android:src="@drawable/forward_icon_selector"
      android:nextFocusRight="@+id/ibRefresh"
      android:background="@drawable/icon_button_bg_selector"
      android:contentDescription="@string/navigate_forward" />

  <ImageButton
      android:id="@+id/ibRefresh"
      android:layout_width="@dimen/toolbar_button_size"
      android:layout_height="@dimen/toolbar_button_size"
      android:scaleType="fitCenter"
      android:padding="8dp"
      android:layout_marginTop="4dp"
      android:src="@drawable/ic_refresh_grey_900_24dp"
      android:nextFocusRight="@+id/etUrl"
      android:background="@drawable/icon_button_bg_selector"
      android:contentDescription="@string/refresh_page" />

  <FrameLayout
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:layout_weight="1"
      android:layout_alignWithParentIfMissing="true"
      android:background="@color/top_bar_background"
      android:id="@+id/flUrl">
    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/etUrl"
        android:iconifiedByDefault="false"
        android:textCursorDrawable="@null"
        android:textColor="@color/default_url_color"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="5dp"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:imeOptions="actionSearch"
        android:hint="@string/url_prompt"
        android:inputType="textFilter|textNoSuggestions|textUri"
        android:importantForAutofill="no" />
  </FrameLayout>

  <ImageButton
      android:id="@+id/ibFavorites"
      android:layout_width="@dimen/toolbar_button_size"
      android:layout_height="@dimen/toolbar_button_size"
      android:scaleType="fitCenter"
      android:padding="8dp"
      android:layout_marginTop="4dp"
      android:layout_marginEnd="2dp"
      android:src="@drawable/ic_star_border_grey_900_36dp"
      android:nextFocusRight="@+id/ibMedia"
      android:background="@drawable/icon_button_bg_selector"
      android:contentDescription="@string/bookmarks" />

  <FrameLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginEnd="2dp">
    <ImageButton
        android:id="@+id/ibMedia"
        android:layout_width="@dimen/toolbar_button_size"
        android:layout_height="@dimen/toolbar_button_size"
        android:scaleType="fitCenter"
        android:padding="8dp"
        android:layout_marginTop="4dp"
        android:src="@drawable/ic_media_stream"
        android:nextFocusRight="@+id/ibMenu"
        android:background="@drawable/icon_button_bg_selector"
        android:contentDescription="@string/media_list" />
    <TextView
        android:id="@+id/tvMediaCounter"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="20dp"
        android:textSize="12sp"
        android:layout_gravity="top|end"
        android:background="@drawable/gray_badge_bg"
        android:gravity="center"
        android:visibility="gone"
        tools:visibility="visible"
        tools:text="1" />
  </FrameLayout>

  <ImageButton
      android:id="@+id/ibMenu"
      android:layout_width="@dimen/toolbar_button_size"
      android:layout_height="@dimen/toolbar_button_size"
      android:scaleType="fitCenter"
      android:padding="8dp"
      android:layout_marginTop="4dp"
      android:layout_marginEnd="4dp"
      android:src="@drawable/ic_more_vert_grey_900_36dp"
      android:nextFocusLeft="@+id/ibMedia"
      android:background="@drawable/icon_button_bg_selector"
      android:contentDescription="@string/menu" />
</merge>
