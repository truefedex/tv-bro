<?xml version="1.0" encoding="utf-8"?>
<!--
The row of the browser bar: close app, page navigation, the address field, browser functions (the less
used ones in the menu of the last button).
Back stays away from the close button and every button stays focusable, so the number of presses
to each button never changes.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.LinearLayout"
    tools:orientation="horizontal">

  <ImageButton
      style="@style/Widget.TVBro.ImageButton.Ds.Standalone"
      android:id="@+id/ibMenu"
      android:src="@drawable/ic_close"
      android:nextFocusDown="@+id/vTabs"
      android:focusableInTouchMode="true"
      android:contentDescription="@string/close_application" />

  <LinearLayout
      style="@style/Widget.TVBro.ToolbarGroup"
      android:id="@+id/llNavigation">

    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.Segment"
        android:id="@+id/ibBack"
        android:src="@drawable/ic_back"
        android:nextFocusDown="@+id/vTabs"
        android:contentDescription="@string/navigate_back" />

    <View style="@style/Widget.TVBro.ToolbarSeparator" />

    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.Segment"
        android:id="@+id/ibForward"
        android:src="@drawable/ic_forward"
        android:nextFocusDown="@+id/vTabs"
        android:contentDescription="@string/navigate_forward" />

    <View style="@style/Widget.TVBro.ToolbarSeparator" />

    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.Segment"
        android:id="@+id/ibRefresh"
        android:src="@drawable/ic_refresh"
        android:nextFocusDown="@+id/vTabs"
        android:contentDescription="@string/refresh_page" />
  </LinearLayout>

  <!-- the site button, the address (the focus stop between the buttons) and the mic -->
  <com.phlox.tvwebbrowser.activity.main.view.AddressFieldLayout
      android:id="@+id/llAddress"
      android:layout_width="0dp"
      android:layout_height="match_parent"
      android:layout_weight="1"
      android:layout_marginStart="@dimen/ds_space_gutter"
      android:orientation="horizontal"
      android:background="@drawable/ds_address_field_bg"
      android:padding="@dimen/ds_border_hairline">

    <!-- sliders, or a warning sign on a page without a secure connection -->
    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.Field"
        android:id="@+id/ibSite"
        android:src="@drawable/ic_site"
        android:nextFocusDown="@+id/vTabs"
        android:contentDescription="@string/site_settings" />

    <View style="@style/Widget.TVBro.FieldDivider" />

    <FrameLayout
        android:id="@+id/flUrl"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:focusable="true"
        android:clickable="true"
        android:nextFocusDown="@+id/vTabs"
        android:contentDescription="@string/url_prompt">

      <!-- focusable only while the address is edited: the address around it is the focus stop -->
      <EditText
          style="@style/Widget.TVBro.Text.Address"
          android:id="@+id/etUrl"
          android:layout_width="match_parent"
          android:layout_height="match_parent"
          android:paddingStart="@dimen/ds_space_field_inset"
          android:paddingEnd="@dimen/ds_space_field_inset"
          android:gravity="center_vertical"
          android:background="@null"
          android:textCursorDrawable="@null"
          android:textColor="?attr/tbColorDsInk"
          android:textColorHint="?attr/tbColorDsInkFaint"
          android:singleLine="true"
          android:focusable="false"
          android:focusableInTouchMode="false"
          android:nextFocusDown="@+id/vTabs"
          android:imeOptions="actionSearch"
          android:hint="@string/url_prompt"
          android:inputType="textFilter|textNoSuggestions|textUri"
          android:importantForAutofill="no" />
    </FrameLayout>

    <View
        style="@style/Widget.TVBro.FieldDivider"
        android:id="@+id/vVoiceSearchDivider" />

    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.Field"
        android:id="@+id/ibVoiceSearch"
        android:src="@drawable/ic_voice_search"
        android:nextFocusDown="@+id/vTabs"
        android:contentDescription="@string/voice_search" />
  </com.phlox.tvwebbrowser.activity.main.view.AddressFieldLayout>

  <LinearLayout
      style="@style/Widget.TVBro.ToolbarGroup"
      android:id="@+id/llFunctions">

    <FrameLayout
        android:layout_width="@dimen/ds_size_toolbar_segment"
        android:layout_height="match_parent">

      <!-- the videos of the page other apps can play; dimmed while there are none, selected (activated)
           while its panel is open -->
      <ImageButton
          style="@style/Widget.TVBro.ImageButton.Ds.Segment"
          android:id="@+id/ibVideos"
          android:layout_width="match_parent"
          android:src="@drawable/ic_video"
          android:nextFocusDown="@+id/vTabs"
          android:contentDescription="@string/videos_on_page" />

      <TextView
          style="@style/Widget.TVBro.Text.CountBadge"
          android:id="@+id/tvVideosBadge"
          android:layout_width="wrap_content"
          android:layout_height="@dimen/ds_size_badge_height"
          android:layout_gravity="top|end"
          android:layout_marginTop="@dimen/ds_badge_margin_top"
          android:layout_marginEnd="@dimen/ds_badge_margin_end"
          android:minWidth="@dimen/ds_size_badge_min_width"
          android:paddingStart="@dimen/ds_badge_padding_horizontal"
          android:paddingEnd="@dimen/ds_badge_padding_horizontal"
          android:gravity="center"
          android:background="@drawable/ds_badge_bg"
          android:textColor="?attr/tbColorDsOnBadge"
          android:importantForAccessibility="no"
          android:visibility="gone"
          tools:text="3"
          tools:visibility="visible" />
    </FrameLayout>

    <View style="@style/Widget.TVBro.ToolbarSeparator" />

    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.Segment"
        android:id="@+id/ibFavorites"
        android:src="@drawable/ic_favorites"
        android:nextFocusDown="@+id/vTabs"
        android:contentDescription="@string/bookmarks" />

    <View style="@style/Widget.TVBro.ToolbarSeparator" />

    <FrameLayout
        android:layout_width="@dimen/ds_size_toolbar_segment"
        android:layout_height="match_parent">

      <!-- selected (activated) while its panel is open -->
      <ImageButton
          style="@style/Widget.TVBro.ImageButton.Ds.Segment"
          android:id="@+id/ibDownloads"
          android:layout_width="match_parent"
          android:src="@drawable/ic_downloads"
          android:nextFocusDown="@+id/vTabs"
          android:contentDescription="@string/downloads" />

      <!-- downloads in progress and paused -->
      <TextView
          style="@style/Widget.TVBro.Text.CountBadge"
          android:id="@+id/tvDownloadsBadge"
          android:layout_width="wrap_content"
          android:layout_height="@dimen/ds_size_badge_height"
          android:layout_gravity="top|end"
          android:layout_marginTop="@dimen/ds_badge_margin_top"
          android:layout_marginEnd="@dimen/ds_badge_margin_end"
          android:minWidth="@dimen/ds_size_badge_min_width"
          android:paddingStart="@dimen/ds_badge_padding_horizontal"
          android:paddingEnd="@dimen/ds_badge_padding_horizontal"
          android:gravity="center"
          android:background="@drawable/ds_badge_bg"
          android:textColor="?attr/tbColorDsOnBadge"
          android:importantForAccessibility="no"
          android:visibility="gone"
          tools:text="2"
          tools:visibility="visible" />
    </FrameLayout>

    <View style="@style/Widget.TVBro.ToolbarSeparator" />

    <!-- selected (activated) in the incognito mode -->
    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.Segment"
        android:id="@+id/ibIncognito"
        android:src="@drawable/ic_incognito"
        android:nextFocusDown="@+id/vTabs"
        android:contentDescription="@string/incognito_mode" />

    <View style="@style/Widget.TVBro.ToolbarSeparator" />

    <!-- History, Phone sync and Settings; selected (activated) while its menu is open -->
    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.Segment"
        android:id="@+id/ibMore"
        android:src="@drawable/ic_more_vert"
        android:nextFocusDown="@+id/vTabs"
        android:contentDescription="@string/more_actions" />
  </LinearLayout>
</merge>
