<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rlRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.main.MainActivity"
    android:fitsSystemWindows="true"
    tools:deviceIds="tv"
    android:clipChildren="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/flWebViewContainer" />

    <ProgressBar
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:id="@+id/progressBar"
        android:progressTint="?attr/tbColorProgress"
        android:visibility="visible" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/rlActionBar"
        android:background="?attr/tbColorDsBgChrome"
        android:elevation="5dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.phlox.tvwebbrowser.activity.main.view.ActionBar
            android:id="@+id/vActionBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_size_chrome_control"
            android:layout_marginStart="@dimen/ds_space_screen_x"
            android:layout_marginEnd="@dimen/ds_space_screen_x"
            android:layout_marginTop="@dimen/ds_space_screen_top" />

        <com.phlox.tvwebbrowser.activity.main.view.tabs.TabsView
            android:id="@+id/vTabs"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_below="@+id/vActionBar"
            android:layout_marginTop="10dp"
            android:focusable="true"
            android:nextFocusUp="@+id/ibMenu"
            android:nextFocusDown="@+id/ibCloseTab"
            />
    </RelativeLayout>

    <ImageView
        android:id="@+id/ivMiniatures"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/llMiniaturePlaceholder"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        android:layout_below="@+id/rlActionBar"
        android:layout_alignWithParentIfMissing="true"
        android:visibility="gone">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_new_tab"
            app:tint="?attr/tbColorIconPlaceholder"
            android:layout_marginEnd="20dp"
            tools:ignore="ContentDescription" />
        <TextView
            style="@style/Widget.TVBro.Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_a_new_tab_here" />
    </LinearLayout>

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/llBottomPanel"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:clipChildren="false"
        android:gravity="center">

        <ImageButton
            style="@style/Widget.TVBro.ImageButton.BottomPanel"
            android:id="@+id/ibCloseTab"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/close_tab"
            android:src="@drawable/ic_close"
            android:layout_margin="3dp"
            app:layout_constraintEnd_toStartOf="@+id/ibAdBlock"
            app:layout_constraintStart_toStartOf="parent" />

        <ImageButton
            style="@style/Widget.TVBro.ImageButton.BottomPanel"
            android:id="@+id/ibAdBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/toggle_ads_blocking"
            android:src="@drawable/ic_adblock_on"
            app:layout_constraintEnd_toStartOf="@+id/ibPopupBlock"
            app:layout_constraintStart_toEndOf="@+id/ibCloseTab"/>

        <ImageButton
            style="@style/Widget.TVBro.ImageButton.BottomPanel"
            android:id="@+id/ibPopupBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/block_popups"
            android:src="@drawable/ic_block_popups"
            app:layout_constraintEnd_toStartOf="@+id/ibHome"
            app:layout_constraintStart_toEndOf="@+id/ibAdBlock"/>

        <ImageButton
            style="@style/Widget.TVBro.ImageButton.BottomPanel"
            android:id="@+id/ibHome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/navigate_home"
            android:src="@drawable/ic_home"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/ibPopupBlock"/>

        <TextView
            style="@style/Widget.TVBro.Text.Badge"
            android:id="@+id/tvBlockedAdCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="20dp"
            app:layout_constraintTop_toTopOf="@+id/ibAdBlock"
            app:layout_constraintBottom_toTopOf="@+id/ibAdBlock"
            app:layout_constraintStart_toEndOf="@+id/ibAdBlock"
            app:layout_constraintEnd_toEndOf="@+id/ibAdBlock"
            android:background="@drawable/gray_badge_bg"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="1" />

        <TextView
            style="@style/Widget.TVBro.Text.Badge"
            android:id="@+id/tvBlockedPopupCounter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="20dp"
            app:layout_constraintTop_toTopOf="@+id/ibPopupBlock"
            app:layout_constraintBottom_toTopOf="@+id/ibPopupBlock"
            app:layout_constraintStart_toEndOf="@+id/ibPopupBlock"
            app:layout_constraintEnd_toEndOf="@+id/ibPopupBlock"
            android:background="@drawable/gray_badge_bg"
            android:gravity="center"
            android:visibility="gone"
            tools:visibility="visible"
            tools:text="1" />
    </androidx.constraintlayout.widget.ConstraintLayout>
    
    <com.phlox.tvwebbrowser.activity.main.view.CursorMenuView
        android:id="@+id/vCursorMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        />

    <ProgressBar
        android:id="@+id/progressBarGeneric"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        />

</RelativeLayout>
