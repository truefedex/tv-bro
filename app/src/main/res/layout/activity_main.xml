<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rlRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".activity.main.MainActivity"
    android:fitsSystemWindows="true"
    tools:deviceIds="tv"
    android:clipChildren="false">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/flWebViewContainer" />

    <!-- along the top edge of the window, above the bar (its elevation is higher), whether the bar is open or not -->
    <ProgressBar
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="3dp"
        android:id="@+id/progressBar"
        android:progressTint="?attr/tbColorProgress"
        android:progressBackgroundTint="@android:color/transparent"
        android:elevation="6dp"
        android:outlineProvider="none"
        android:visibility="visible" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/rlActionBar"
        android:background="?attr/tbColorDsBgChrome"
        android:elevation="5dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <com.phlox.tvwebbrowser.activity.main.view.ActionBar
            android:id="@+id/vActionBar"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_size_chrome_control"
            android:layout_marginStart="@dimen/ds_space_screen_x"
            android:layout_marginEnd="@dimen/ds_space_screen_x"
            android:layout_marginTop="@dimen/ds_space_screen_top" />

        <!-- the bottom edge of the bar; the tabs are drawn over it -->
        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_border_hairline"
            android:layout_alignBottom="@+id/vTabs"
            android:background="?attr/tbColorDsLine" />

        <com.phlox.tvwebbrowser.activity.main.view.tabs.TabsView
            android:id="@+id/vTabs"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ds_size_tab_height"
            android:layout_below="@+id/vActionBar"
            android:layout_marginTop="@dimen/ds_tab_strip_margin_top"
            android:paddingStart="@dimen/ds_space_screen_x"
            android:paddingEnd="@dimen/ds_space_screen_x"
            android:clipToPadding="false"
            android:focusable="true"
            />
    </RelativeLayout>

    <ImageView
        android:id="@+id/ivMiniatures"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        tools:ignore="ContentDescription" />

    <LinearLayout
        android:id="@+id/llMiniaturePlaceholder"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerInside"
        android:layout_below="@+id/rlActionBar"
        android:layout_alignWithParentIfMissing="true"
        android:visibility="gone">
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/ic_new_tab"
            app:tint="?attr/tbColorIconPlaceholder"
            android:layout_marginEnd="20dp"
            tools:ignore="ContentDescription" />
        <TextView
            style="@style/Widget.TVBro.Text.Headline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/open_a_new_tab_here" />
    </LinearLayout>

    
    <!-- under the focused tab: Down opens its menu -->
    <LinearLayout
        android:id="@+id/llTabOptionsHint"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/ds_tab_hint_height"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/ds_tab_hint_padding_start"
        android:paddingEnd="@dimen/ds_tab_hint_padding_end"
        android:background="@drawable/ds_hint_bg"
        android:elevation="6dp"
        android:visibility="gone"
        android:importantForAccessibility="no">
        <ImageView
            android:layout_width="@dimen/ds_tab_hint_icon"
            android:layout_height="@dimen/ds_tab_hint_icon"
            android:src="@drawable/ic_chevron_down"
            app:tint="?attr/tbColorDsIcon"
            tools:ignore="ContentDescription" />
        <TextView
            style="@style/Widget.TVBro.Text.TabTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ds_tab_hint_icon_text"
            android:fontFamily="sans-serif"
            android:textColor="?attr/tbColorDsInk"
            android:text="@string/tab_options" />
    </LinearLayout>

    <!-- above the bar (their elevation is higher) -->
    <com.phlox.tvwebbrowser.activity.main.view.TabMenuView
        android:id="@+id/vTabMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="7dp"
        android:outlineProvider="none" />

    <com.phlox.tvwebbrowser.activity.main.view.SitePanelView
        android:id="@+id/vSitePanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="7dp"
        android:outlineProvider="none" />

    <com.phlox.tvwebbrowser.activity.main.view.BookmarksPanelView
        android:id="@+id/vBookmarksPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="7dp"
        android:outlineProvider="none" />

    <!-- all downloads, over the whole window and the bar; its menus and the downloads panel go above it -->
    <com.phlox.tvwebbrowser.activity.main.view.DownloadsScreenView
        android:id="@+id/vDownloadsScreen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="7dp"
        android:outlineProvider="none" />

    <com.phlox.tvwebbrowser.activity.main.view.DownloadsPanelView
        android:id="@+id/vDownloadsPanel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="7dp"
        android:outlineProvider="none" />

    <!-- the menus of the bookmarks and downloads panels, above them -->
    <com.phlox.tvwebbrowser.activity.main.view.PopupMenuView
        android:id="@+id/vPopupMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="8dp"
        android:outlineProvider="none" />

    <com.phlox.tvwebbrowser.activity.main.view.CursorMenuView
        android:id="@+id/vCursorMenu"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="invisible"
        android:clipChildren="false"
        android:clipToPadding="false"
        />

    <ProgressBar
        android:id="@+id/progressBarGeneric"
        style="?android:attr/progressBarStyleLarge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:focusable="true"
        android:focusableInTouchMode="true"
        />

</RelativeLayout>
