<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the phone bookmarks screen: a folder, a bookmark or a folder to choose, with the button of its options -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="?attr/tbColorDsSurface">

  <View
      style="@style/Widget.TVBro.MenuSeparator"
      android:id="@+id/vDivider" />

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="@dimen/ds_phone_bookmark_row_height"
      android:orientation="horizontal"
      android:gravity="center_vertical">

    <LinearLayout
        android:id="@+id/llMain"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/ds_phone_bookmark_row_padding"
        android:paddingEnd="@dimen/ds_phone_menu_row_padding"
        android:background="@drawable/ds_menu_row_bg"
        android:focusable="true"
        android:clickable="true">

      <ImageView
          android:id="@+id/ivIcon"
          android:layout_width="@dimen/ds_phone_quick_button_icon"
          android:layout_height="@dimen/ds_phone_quick_button_icon"
          android:scaleType="fitCenter"
          android:importantForAccessibility="no" />

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:paddingTop="@dimen/ds_bookmark_row_text_padding"
          android:paddingBottom="@dimen/ds_bookmark_row_text_padding"
          android:layout_marginStart="@dimen/ds_phone_bookmark_icon_text"
          android:orientation="vertical">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/ds_text_phone_menu_item"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/tbColorDsInk"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="Wikipedia" />

        <TextView
            android:id="@+id/tvCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/ds_text_phone_caption"
            android:textColor="?attr/tbColorDsInk"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="www.wikipedia.org" />
      </LinearLayout>

      <!-- a chevron on folders, a check on the folder that is chosen -->
      <ImageView
          style="@style/Widget.TVBro.MenuIcon"
          android:id="@+id/ivEnd"
          android:layout_marginStart="@dimen/ds_phone_menu_row_padding"
          tools:src="@drawable/ic_chevron_right" />
    </LinearLayout>

    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.Phone"
        android:id="@+id/ibOptions"
        android:layout_marginEnd="@dimen/ds_phone_bar_padding_horizontal"
        android:src="@drawable/ic_more_vert"
        tools:contentDescription="Options of Wikipedia" />
  </LinearLayout>
</LinearLayout>
