<?xml version="1.0" encoding="utf-8"?>
<!--
A row of the TV history (the list draws the dividers between rows): the check box in the selection
mode, the time, the favicon, the title and the address, what OK does on the focused row; then the
button of its options (not in the selection mode).
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical">

  <!-- not match_parent: the row is as tall as its texts (a match_parent child adds no height to its row) -->
  <LinearLayout
      android:id="@+id/llMain"
      android:layout_width="0dp"
      android:layout_height="wrap_content"
      android:minHeight="@dimen/ds_download_row_height"
      android:layout_weight="1"
      android:orientation="horizontal"
      android:gravity="center_vertical"
      android:paddingStart="@dimen/ds_space_menu_inset"
      android:paddingEnd="@dimen/ds_space_icon_text"
      android:background="@drawable/ds_menu_row_bg"
      android:focusable="true"
      android:clickable="true"
      android:longClickable="true">

    <ImageView
        style="@style/Widget.TVBro.MenuIcon"
        android:id="@+id/ivCheck"
        android:layout_width="@dimen/ds_size_icon_toolbar"
        android:layout_height="@dimen/ds_size_icon_toolbar"
        android:layout_marginEnd="@dimen/ds_space_icon_text"
        android:src="@drawable/ic_check_box_blank"
        android:visibility="gone"
        tools:visibility="visible" />

    <TextView
        style="@style/Widget.TVBro.Text.MenuItem"
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minWidth="@dimen/ds_history_time_width"
        android:layout_marginEnd="@dimen/ds_space_icon_text"
        android:textColor="?attr/tbColorDsInk"
        android:fontFeatureSettings="tnum"
        android:singleLine="true"
        tools:text="14:32" />

    <ImageView
        android:id="@+id/ivIcon"
        android:layout_width="@dimen/ds_bookmark_icon"
        android:layout_height="@dimen/ds_bookmark_icon"
        android:scaleType="fitCenter"
        android:importantForAccessibility="no"
        tools:src="@drawable/ic_not_available" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:paddingTop="@dimen/ds_bookmark_row_text_padding"
        android:paddingBottom="@dimen/ds_bookmark_row_text_padding"
        android:layout_marginStart="@dimen/ds_space_icon_text"
        android:orientation="vertical">

      <TextView
          style="@style/Widget.TVBro.Text.MenuItem"
          android:id="@+id/tvTitle"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:fontFamily="sans-serif-medium"
          android:textColor="?attr/tbColorDsInk"
          android:singleLine="true"
          android:ellipsize="end"
          tools:text="Wikipedia, the free encyclopedia" />

      <TextView
          style="@style/Widget.TVBro.Text.MenuCaption"
          android:id="@+id/tvCaption"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:textColor="?attr/tbColorDsInk"
          android:singleLine="true"
          android:ellipsize="end"
          tools:text="en.wikipedia.org" />
    </LinearLayout>

    <!-- what OK does, on the focused row -->
    <TextView
        style="@style/Widget.TVBro.Text.MenuItem"
        android:id="@+id/tvHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ds_download_hint_padding"
        android:textColor="?attr/tbColorDsInk"
        android:visibility="gone"
        tools:text="@string/open"
        tools:visibility="visible" />
  </LinearLayout>

  <ImageButton
      style="@style/Widget.TVBro.ImageButton.Ds.Panel"
      android:id="@+id/ibOptions"
      android:layout_marginStart="@dimen/ds_bookmark_options_margin"
      android:layout_marginEnd="@dimen/ds_bookmark_options_margin"
      android:src="@drawable/ic_more_vert"
      tools:contentDescription="Options of Wikipedia" />
</LinearLayout>
