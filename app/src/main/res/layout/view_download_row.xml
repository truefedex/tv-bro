<?xml version="1.0" encoding="utf-8"?>
<!--
A row of the TV downloads panel and screen (the lists draw the dividers between rows): the icon of the kind of the file, its name, a caption (the
size, the time and the site, or the progress) and the progress bar of a download in progress; then up to
two buttons (pause or resume and cancel, or download again) and the button of its options.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:minHeight="@dimen/ds_download_row_height"
      android:orientation="horizontal"
      android:gravity="center_vertical">

    <!-- not match_parent: the row is as tall as its texts (a match_parent child adds no height to its row) -->
    <LinearLayout
        android:id="@+id/llMain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/ds_download_row_height"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="@dimen/ds_space_menu_inset"
        android:paddingEnd="@dimen/ds_space_icon_text"
        android:background="@drawable/ds_menu_row_bg"
        android:focusable="true"
        android:clickable="true"
        android:longClickable="true">

      <ImageView
          style="@style/Widget.TVBro.DownloadIcon"
          android:id="@+id/ivIcon"
          tools:src="@drawable/ic_app" />

      <LinearLayout
          android:layout_width="0dp"
          android:layout_height="wrap_content"
          android:layout_weight="1"
          android:paddingTop="@dimen/ds_bookmark_row_text_padding"
          android:paddingBottom="@dimen/ds_bookmark_row_text_padding"
          android:layout_marginStart="@dimen/ds_space_icon_text"
          android:orientation="vertical">

        <TextView
            style="@style/Widget.TVBro.Text.MenuItem"
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:textColor="?attr/tbColorDsInk"
            android:singleLine="true"
            android:ellipsize="middle"
            tools:text="tvbro-2.4.0-arm64-v8a.apk" />

        <TextView
            style="@style/Widget.TVBro.Text.MenuCaption"
            android:id="@+id/tvCaption"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="?attr/tbColorDsInk"
            android:singleLine="true"
            android:ellipsize="end"
            tools:text="18.6 MB of 48.2 MB · 2.4 MB/s · 12 s left" />

        <ProgressBar
            style="@style/Widget.TVBro.DownloadProgress"
            android:id="@+id/pbProgress"
            tools:progress="390" />
      </LinearLayout>

      <!-- what OK does, on the focused row of the screen -->
      <TextView
          style="@style/Widget.TVBro.Text.MenuItem"
          android:id="@+id/tvHint"
          android:layout_width="wrap_content"
          android:layout_height="wrap_content"
          android:layout_marginStart="@dimen/ds_download_hint_padding"
          android:textColor="?attr/tbColorDsInk"
          android:visibility="gone"
          tools:text="@string/install"
          tools:visibility="visible" />
    </LinearLayout>

    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.Panel"
        android:id="@+id/ibFirst"
        android:layout_marginStart="@dimen/ds_bookmark_options_margin"
        tools:src="@drawable/ic_pause" />

    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.Panel"
        android:id="@+id/ibSecond"
        android:layout_marginStart="@dimen/ds_bookmark_options_margin"
        tools:src="@drawable/ic_close" />

    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.Panel"
        android:id="@+id/ibOptions"
        android:layout_marginStart="@dimen/ds_bookmark_options_margin"
        android:layout_marginEnd="@dimen/ds_bookmark_options_margin"
        android:src="@drawable/ic_more_vert"
        tools:contentDescription="Options of tvbro-2.4.0-arm64-v8a.apk" />
  </LinearLayout>
</LinearLayout>
