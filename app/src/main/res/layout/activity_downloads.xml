<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/activity_downloads"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?attr/tbColorSurface"
    tools:context="com.phlox.tvwebbrowser.activity.downloads.DownloadsActivity">

    <com.phlox.tvwebbrowser.widgets.NearestFocusRecyclerView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical" />

    <TextView
        style="@style/Widget.TVBro.Text.Headline"
        android:text="@string/nothing"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:id="@+id/tvPlaceholder"
        android:gravity="center"
        android:textColor="?attr/tbColorOnSurfaceVariant"/>
</RelativeLayout>
