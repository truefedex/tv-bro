<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="horizontal"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <com.fedir.segmentedbutton.SegmentedButton
        android:id="@+id/sbTabs"
        android:layout_width="wrap_content"
        android:layout_height="match_parent"
        android:orientation="vertical"
        app:checkedButton="@+id/btnGeneralTab"
        app:cornerRadiusX="0"
        app:cornerRadiusY="0">
        <Button
            android:id="@+id/btnGeneralTab"
            android:layout_width="@dimen/settings_tab_width"
            android:layout_height="@dimen/settings_tab_height"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:textSize="14sp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:gravity="center_vertical|start"
            android:text="@string/settings_category_general"
            android:background="@drawable/settings_tab_bg_selector"/>
        <Button
            android:id="@+id/btnAdsTab"
            android:layout_width="@dimen/settings_tab_width"
            android:layout_height="@dimen/settings_tab_height"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:textSize="14sp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:gravity="center_vertical|start"
            android:text="@string/settings_category_ads_and_privacy"
            android:background="@drawable/settings_tab_bg_selector"
            android:layout_marginTop="1dp"/>
        <Button
            android:id="@+id/btnAppearanceTab"
            android:layout_width="@dimen/settings_tab_width"
            android:layout_height="@dimen/settings_tab_height"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:textSize="14sp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:gravity="center_vertical|start"
            android:text="@string/settings_category_appearance"
            android:background="@drawable/settings_tab_bg_selector"
            android:layout_marginTop="1dp"/>
        <Button
            android:id="@+id/btnPlaybackTab"
            android:layout_width="@dimen/settings_tab_width"
            android:layout_height="@dimen/settings_tab_height"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:textSize="14sp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:gravity="center_vertical|start"
            android:text="@string/settings_category_playback"
            android:background="@drawable/settings_tab_bg_selector"
            android:layout_marginTop="1dp"/>
        <Button
            android:id="@+id/btnControlsTab"
            android:layout_width="@dimen/settings_tab_width"
            android:layout_height="@dimen/settings_tab_height"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:textSize="14sp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:gravity="center_vertical|start"
            android:text="@string/settings_category_controls"
            android:background="@drawable/settings_tab_bg_selector"
            android:layout_marginTop="1dp"/>
        <Button
            android:id="@+id/btnAdvancedTab"
            android:layout_width="@dimen/settings_tab_width"
            android:layout_height="@dimen/settings_tab_height"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:textSize="14sp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:gravity="center_vertical|start"
            android:text="@string/settings_category_advanced"
            android:background="@drawable/settings_tab_bg_selector"
            android:layout_marginTop="1dp"/>
        <Button
            android:id="@+id/btnVersionTab"
            android:layout_width="@dimen/settings_tab_width"
            android:layout_height="@dimen/settings_tab_height"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:textSize="14sp"
            android:paddingLeft="16dp"
            android:paddingRight="16dp"
            android:gravity="center_vertical|start"
            android:text="@string/settings_category_about"
            android:background="@drawable/settings_tab_bg_selector"
            android:layout_marginTop="1dp"/>
    </com.fedir.segmentedbutton.SegmentedButton>

    <FrameLayout
        android:id="@+id/flTabsContent"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1">
    </FrameLayout>
</LinearLayout>
