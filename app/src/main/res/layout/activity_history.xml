<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="?attr/tbColorSurface">
    <com.phlox.tvwebbrowser.widgets.NearestFocusRecyclerView
        android:id="@+id/listView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scrollbars="vertical" />
    <Button
        style="@style/Widget.TVBro.Button"
        android:id="@+id/btnClear"
        android:layout_width="wrap_content"
        android:layout_height="?android:attr/listPreferredItemHeight"
        android:layout_alignParentEnd="true"
        android:text="@string/clear"
        android:layout_margin="5dp"
        android:onClick="onClearHistoryClick"
        android:textColor="?attr/tbColorOnSurfaceVariant"
        android:nextFocusDown="@+id/listView"/>
    <ImageButton
        style="@style/Widget.TVBro.ImageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:src="@drawable/ic_delete_large"
        android:visibility="gone"
        android:nextFocusLeft="@+id/listView"
        android:focusable="true"
        android:onClick="onClearHistoryItemsClick"
        android:id="@+id/ibDelete"/>
</RelativeLayout>