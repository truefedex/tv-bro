<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="170dp"
    android:layout_height="170dp">

    <ImageButton
        android:id="@+id/btnGrabMode"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@android:color/transparent"
        android:src="@drawable/ic_grab_mode"
        app:tint="?attr/tbColorIconCursorMenu"
        android:defaultFocusHighlightEnabled="false"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        style="@style/Widget.TVBro.ImageButton.CursorMenu"
        android:id="@+id/btnZoomIn"
        android:layout_width="@dimen/cursor_menu_button_size"
        android:layout_height="@dimen/cursor_menu_button_size"
        android:src="@drawable/ic_zoom_in"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageButton
        style="@style/Widget.TVBro.ImageButton.CursorMenu"
        android:id="@+id/btnZoomOut"
        android:layout_width="@dimen/cursor_menu_button_size"
        android:layout_height="@dimen/cursor_menu_button_size"
        android:src="@drawable/ic_zoom_out"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageButton
        style="@style/Widget.TVBro.ImageButton.CursorMenu"
        android:id="@+id/btnContextMenu"
        android:layout_width="@dimen/cursor_menu_button_size"
        android:layout_height="@dimen/cursor_menu_button_size"
        android:src="@drawable/ic_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageButton
        style="@style/Widget.TVBro.ImageButton.CursorMenu"
        android:id="@+id/btnDPADMode"
        android:layout_width="@dimen/cursor_menu_button_size"
        android:layout_height="@dimen/cursor_menu_button_size"
        android:src="@drawable/ic_dpad_mode"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>