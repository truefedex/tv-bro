<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/ds_cursor_menu_size"
    android:layout_height="@dimen/ds_cursor_menu_size"
    android:background="@drawable/ds_cursor_menu_bg"
    android:elevation="@dimen/ds_cursor_menu_elevation">

    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.CursorMenu.Center"
        android:id="@+id/btnGrabMode"
        android:src="@drawable/ic_grab_mode"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.CursorMenu"
        android:id="@+id/btnZoomIn"
        android:layout_marginEnd="@dimen/ds_cursor_menu_inset"
        android:src="@drawable/ic_zoom_in"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.CursorMenu"
        android:id="@+id/btnZoomOut"
        android:layout_marginStart="@dimen/ds_cursor_menu_inset"
        android:src="@drawable/ic_zoom_out"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.CursorMenu"
        android:id="@+id/btnContextMenu"
        android:layout_marginTop="@dimen/ds_cursor_menu_inset"
        android:src="@drawable/ic_menu"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <ImageButton
        style="@style/Widget.TVBro.ImageButton.Ds.CursorMenu"
        android:id="@+id/btnDPADMode"
        android:layout_marginBottom="@dimen/ds_cursor_menu_inset"
        android:src="@drawable/ic_dpad_mode"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
