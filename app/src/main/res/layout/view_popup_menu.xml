<?xml version="1.0" encoding="utf-8"?>
<!-- A menu over the screen, built from its rows (view_popup_menu_row). The focus does not leave its rows while it is open.
     A menu taller than the screen scrolls: the focused row is scrolled into view. -->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

  <ScrollView
      android:id="@+id/svMenu"
      android:layout_width="@dimen/ds_bookmark_menu_width"
      android:layout_height="wrap_content"
      android:background="@drawable/ds_menu_bg"
      android:elevation="4dp"
      android:clickable="true"
      android:scrollbars="none"
      android:overScrollMode="never">

    <LinearLayout
        android:id="@+id/llMenu"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
  </ScrollView>
</merge>
