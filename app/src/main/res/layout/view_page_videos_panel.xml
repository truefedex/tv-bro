<?xml version="1.0" encoding="utf-8"?>
<!--
The TV panel of the videos of the page under the Videos button of the bar (VideosPanelView): the videos
other apps can play. The focus does not leave the panel while it is open.
-->
<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="android.widget.FrameLayout">

  <LinearLayout
      android:id="@+id/llPanel"
      android:layout_width="@dimen/ds_videos_panel_width"
      android:layout_height="wrap_content"
      android:orientation="vertical"
      android:background="@drawable/ds_menu_bg"
      android:elevation="4dp"
      android:clickable="true">

    <TextView
        style="@style/Widget.TVBro.Text.MenuItem"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ds_bookmarks_header_height"
        android:paddingStart="@dimen/ds_space_menu_inset"
        android:paddingEnd="@dimen/ds_space_menu_inset"
        android:gravity="center_vertical"
        android:fontFamily="sans-serif-medium"
        android:textColor="?attr/tbColorDsInk"
        android:singleLine="true"
        android:ellipsize="end"
        android:text="@string/videos_on_page" />

    <View style="@style/Widget.TVBro.MenuSeparator" />

    <!-- focusable: with no videos it holds the focus of the panel -->
    <TextView
        style="@style/Widget.TVBro.Text.MenuItem"
        android:id="@+id/tvEmpty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/ds_bookmarks_empty_padding"
        android:gravity="center"
        android:textColor="?attr/tbColorDsInk"
        android:focusable="true"
        android:text="@string/no_videos_on_page"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />
  </LinearLayout>
</merge>
