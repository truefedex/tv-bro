<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true" android:state_focused="false">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="?attr/tbColorButtonStroke" />
            <stroke android:color="?attr/tbColorButtonStroke" android:width="1dp" />
            <padding android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp" />
        </shape>
    </item>
    <item android:state_checked="true" android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="?attr/tbColorButtonStroke" />
            <stroke android:color="?attr/tbColorButtonStrokeFocused" android:width="1dp" />
            <padding android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp" />
        </shape>
    </item>
    <item android:state_enabled="false" android:state_focused="false">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="?attr/tbColorButtonPressed" />
            <stroke android:color="?attr/tbColorButtonStroke" android:width="1dp" />
            <padding android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp" />
        </shape>
    </item>
    <item android:state_enabled="false" android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="?attr/tbColorButtonPressed" />
            <stroke android:color="?attr/tbColorButtonStrokeFocused" android:width="1dp" />
            <padding android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="?attr/tbColorButtonPressed" />
            <stroke android:color="?attr/tbColorButtonStroke" android:width="1dp" />
            <padding android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="?attr/tbColorButtonFocused" />
            <stroke android:color="?attr/tbColorButtonStrokeFocused" android:width="1dp" />
            <padding android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="5dp" />
            <solid android:color="?attr/tbColorButton" />
            <stroke android:color="?attr/tbColorButtonStroke" android:width="1dp" />
            <padding android:bottom="10dp" android:left="10dp" android:right="10dp" android:top="10dp" />
        </shape>
    </item>
</selector>