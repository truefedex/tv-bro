<?xml version="1.0" encoding="utf-8"?>
<!-- A button inside the address field (the site button, the mic): no fill at rest, focused (with the focus outline) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tbColorDsControlFocused" />
            <stroke android:color="?attr/tbColorDsFocus" android:width="@dimen/ds_focus_outline" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tbColorDsControlFocused" />
            <stroke android:color="?attr/tbColorDsFocus" android:width="@dimen/ds_focus_outline" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
