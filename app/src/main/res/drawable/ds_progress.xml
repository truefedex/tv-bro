<?xml version="1.0" encoding="utf-8"?>
<!-- The progress of a download: the track in the line color, the received part in the icon color -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ds_download_progress_radius" />
            <solid android:color="?attr/tbColorDsLine" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/ds_download_progress_radius" />
                <solid android:color="?attr/tbColorDsIcon" />
            </shape>
        </clip>
    </item>
</layer-list>
