<?xml version="1.0" encoding="utf-8"?>
<!-- The track of a slider: control, the part up to the value in the icon color -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ds_settings_slider_track" />
            <solid android:color="?attr/tbColorDsControl" />
        </shape>
    </item>
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="@dimen/ds_settings_slider_track" />
                <solid android:color="?attr/tbColorDsIcon" />
            </shape>
        </clip>
    </item>
</layer-list>
