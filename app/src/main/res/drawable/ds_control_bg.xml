<?xml version="1.0" encoding="utf-8"?>
<!-- A toolbar segment (inside a ds_control_group_bg group): control, focused, selected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tbColorDsControlFocused" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tbColorDsControlFocused" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tbColorDsControlSelected" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="?attr/tbColorDsControlSelected" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="?attr/tbColorDsControl" />
        </shape>
    </item>
</selector>
