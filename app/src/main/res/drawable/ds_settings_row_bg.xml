<?xml version="1.0" encoding="utf-8"?>
<!-- A row of the TV settings, rounded inside its card, and a category of the rail: pressed, focused (with the focus outline), selected -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ds_radius_control" />
            <solid android:color="?attr/tbColorDsControlFocused" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ds_radius_control" />
            <solid android:color="?attr/tbColorDsControlFocused" />
            <stroke android:color="?attr/tbColorDsFocus" android:width="@dimen/ds_focus_outline" />
        </shape>
    </item>
    <item android:state_hovered="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ds_radius_control" />
            <solid android:color="?attr/tbColorDsControlFocused" />
            <stroke android:color="?attr/tbColorDsFocus" android:width="@dimen/ds_focus_outline" />
        </shape>
    </item>
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ds_radius_control" />
            <solid android:color="?attr/tbColorDsControlSelected" />
        </shape>
    </item>
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <corners android:radius="@dimen/ds_radius_control" />
            <solid android:color="?attr/tbColorDsControlSelected" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@android:color/transparent" />
        </shape>
    </item>
</selector>
